{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*).(mp4|webm|mp3|jpg|png|svg|jpeg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
